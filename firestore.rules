rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ─── Per-user data ────────────────────────────────────────────────────
    // users/{uid} and everything beneath it (transactions, incomeTransactions,
    // categories, incomeCategories, additionalExpenses, pinnedBills,
    // learnedMappings, learnedIncomeMappings, uploaded_files, settings,
    // savingsInsights, …) is readable and writable only by its owner.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Rules OR together, so bankConnections must be excluded here rather
      // than restricted in its own block.
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(uid) && subcollection != "bankConnections";
      }

      // Sync status of saved bank connections. Written only by the server
      // (Admin SDK); the owner may read it but never edit it, so the client
      // can't flip a disabled connection back to active.
      match /bankConnections/{connectionId} {
        allow read: if isOwner(uid);
      }
    }

    // Encrypted bank credentials. No client — not even the owner — may read,
    // list or write them; only the Admin SDK (which bypasses rules) can.
    match /bankSecrets/{connectionId} {
      allow read, write: if false;
    }

    // Everything else — including the legacy top-level collections written
    // before per-user storage existed (transactions, categories, pinnedBills,
    // learnedMappings, …) — is denied by default. The server-side bank sync
    // uses the Admin SDK, which bypasses these rules.
  }
}
