rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ─── Per-user data ────────────────────────────────────────────────────
    // users/{uid} and everything beneath it (transactions, incomeTransactions,
    // categories, incomeCategories, additionalExpenses, pinnedBills,
    // learnedMappings, learnedIncomeMappings, uploaded_files, settings,
    // savingsInsights, …) is readable and writable only by its owner.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else — including the legacy top-level collections written
    // before per-user storage existed (transactions, categories, pinnedBills,
    // learnedMappings, …) — is denied by default. The server-side bank sync
    // uses the Admin SDK, which bypasses these rules.
  }
}
