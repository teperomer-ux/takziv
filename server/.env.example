PORT=8080
FIREBASE_PROJECT_ID=takziv-25fd8
# Comma-separated origins allowed to call the API (the dashboard's URL)
ALLOWED_ORIGINS=http://localhost:5173
# Simultaneous Chromium instances per server instance (~300-500MB RAM each)
MAX_CONCURRENT_SCRAPES=2
# Local dev only: path to a service-account JSON (Cloud Run uses its own identity)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Cloud KMS key that wraps stored bank credentials (printed by infra/setup-kms.sh)
KMS_CREDENTIALS_KEY=projects/takziv-25fd8/locations/me-west1/keyRings/takziv/cryptoKeys/bank-credentials

# AI assistant (POST /api/ai/query) - set ONE key. Anthropic is used when both are set.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# Optional: force a provider (anthropic|gemini) and/or a model
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5-5   (Gemini default: gemini-3.5-flash; free tier allows ~5 requests/minute)

# ── Bank session persistence ───────────────────────────────────────────────
# The device state a bank sets on login (cookies, localStorage) is always
# saved encrypted with the connection and restored on the next sync, so the
# bank keeps recognising the device instead of asking for an SMS code.
# Optionally also keep full Chromium profiles on disk, one per connection
# (local/VM only; Cloud Run's filesystem doesn't persist):
#SCRAPER_USER_DATA_DIR=.profiles
# Scrape timeout in ms (default 180000). Raise it when completing a one-time
# code by hand in a visible browser (npm run scrape:test -- --show-browser --save-session).
#SCRAPE_TIMEOUT_MS=180000
