PORT=8080
FIREBASE_PROJECT_ID=takziv-25fd8
# Comma-separated origins allowed to call the API (the dashboard's URL)
ALLOWED_ORIGINS=http://localhost:5173
# Simultaneous Chromium instances per server instance (~300-500MB RAM each)
MAX_CONCURRENT_SCRAPES=2
# Local dev only: path to a service-account JSON (Cloud Run uses its own identity)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Cloud KMS key that wraps stored bank credentials (printed by infra/setup-kms.sh)
KMS_CREDENTIALS_KEY=projects/takziv-25fd8/locations/me-west1/keyRings/takziv/cryptoKeys/bank-credentials
