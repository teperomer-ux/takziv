{
  "name": "takziv-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "build/server/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env build/server/src/index.js",
    "scrape:test": "tsc && node --env-file-if-exists=.env build/server/scripts/test-scrape.js",
    "test": "tsc && node --test \"build/server/test/**/*.test.js\""
  },
  "dependencies": {
    "@google-cloud/kms": "^6.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "israeli-bank-scrapers": "^6.12.2",
    "puppeteer": "^24.43.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
